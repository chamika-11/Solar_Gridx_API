# Local development configuration. Copy to .env and replace every placeholder.
ASPNETCORE_ENVIRONMENT=Development
Jwt__Secret=replace-with-a-random-secret-of-at-least-32-characters
Jwt__Issuer=SolarGridX.Api
Jwt__Audience=SolarGridX.Clients
Jwt__ExpirationMinutes=60
MongoDb__ConnectionString=mongodb://localhost:27017
MongoDb__DatabaseName=SolarGridX
Cors__AllowedOrigins__0=http://localhost:5173

# Set Enabled=true only for the first application start against an empty staff database.
# The initial Backoffice is created once; after that, create all staff accounts through POST /api/users.
Seed__Enabled=false
Seed__Email=initial.backoffice@example.com
Seed__Password=replace-with-a-strong-password
Seed__FirstName=Initial
Seed__LastName=Backoffice
